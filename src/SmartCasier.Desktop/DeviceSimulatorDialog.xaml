<Window x:Class="SmartCasier.Desktop.DeviceSimulatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulator Perangkat — Smart Casier" Width="850" Height="750"
        MinWidth="700" MinHeight="625" WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
            <RowDefinition Height="*"/><RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Simulator Scanner &amp; Encoder" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Perangkat VIRTUAL saja. Tidak membaca sensor, tidak menggerakkan pisau, dan tidak menjual barang otomatis."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Margin="0,5,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Barcode / SKU untuk scanner virtual" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="BarcodeBox" Text="BAUT-M8X30"
                         AutomationProperties.Name="Kode simulasi barcode"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Scan Virtual" Click="Scan_Click"
                    Style="{StaticResource PrimaryButton}" Margin="12,23,0,0"
                    AutomationProperties.Name="Kirim barcode virtual ke antrian"/>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Umpan material virtual (meter; contoh 0.25)" FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="FeedBox" Text="0.25"
                         AutomationProperties.Name="Panjang umpan material virtual dalam meter"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Tambah Umpan" Click="Feed_Click"
                    Margin="12,23,8,0"/>
            <Button Grid.Column="2" Content="Catat Potong Virtual" Click="Cut_Click"
                    Margin="0,23,0,0" Style="{StaticResource PrimaryButton}"
                    AutomationProperties.Name="Buat event hasil potong virtual"/>
        </Grid>
        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <TextBlock Text="Umpan terkumpul: " Foreground="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="LengthLabel" FontWeight="SemiBold" Text="0 m"/>
            <TextBlock Text="   ·   Hasil potong hanya event, bukan bukti panjang akurat."
                       Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <Grid Grid.Row="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Event PENDING (tersimpan dalam SQLite)" FontSize="16" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="Muat Ulang" Click="Refresh_Click"
                        Margin="0" MinHeight="32"/>
            </Grid>
            <DataGrid Grid.Row="2" x:Name="PendingGrid"
                      ItemsSource="{Binding PendingEvents}"
                      SelectionChanged="PendingGrid_SelectionChanged"
                      AutomationProperties.Name="Antrian simulasi perangkat yang menunggu konfirmasi">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Event ID" Binding="{Binding ShortId}" Width="1.2*"/>
                    <DataGridTextColumn Header="Perangkat" Binding="{Binding DeviceId}" Width="1.4*"/>
                    <DataGridTextColumn Header="Tipe" Binding="{Binding Kind}" Width="0.85*"/>
                    <DataGridTextColumn Header="Isi Event" Binding="{Binding Payload}" Width="2.0*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Grid.Row="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Konfirmasi SKU (wajib sesuai barang yang dimaksud)"
                           Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="SkuBox" MaxLength="64"
                         AutomationProperties.Name="SKU untuk konfirmasi event"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Tolak Event" Click="Reject_Click"
                    Margin="12,23,8,0"/>
            <Button Grid.Column="2" Content="ACK &amp; Tambahkan ke Keranjang"
                    Click="Acknowledge_Click" Margin="0,23,0,0"
                    Style="{StaticResource PrimaryButton}"
                    AutomationProperties.Name="Konfirmasi event dan ajukan item ke keranjang"/>
        </Grid>
        <Grid Grid.Row="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SimulatorStatus" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Text="Pilih event lalu konfirmasi SKU. Tidak ada penjualan sebelum checkout."
                       AutomationProperties.LiveSetting="Polite"/>
            <Button Grid.Column="1" Content="Tutup" IsCancel="True" Width="92"
                    Margin="10,0,0,0"/>
        </Grid>
    </Grid>
</Window>