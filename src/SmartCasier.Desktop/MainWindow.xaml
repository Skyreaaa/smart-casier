<Window x:Class="SmartCasier.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Casier — POS Offline" Width="1440" Height="900"
        MinWidth="1080" MinHeight="690" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="SMART CASIER" FontSize="25" FontWeight="Bold" Foreground="#176B5B"/>
                <TextBlock Text="Kasir offline · katalog non-makanan · pembayaran tunai"
                           FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ModeText" Text="MODE PRODUKSI — DATA LOKAL"
                           FontWeight="SemiBold" Foreground="#5D4336" HorizontalAlignment="Right"/>
                <TextBlock x:Name="DatabaseText" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" HorizontalAlignment="Right" MaxWidth="550" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#D5DFDC" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="*"/><RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="Katalog Produk" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="F2: fokus pencarian" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Right" DockPanel.Dock="Right" />
                    </DockPanel>
                    <TextBox Grid.Row="2" x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                             ToolTip="Cari dengan nama, SKU, alias atau barcode. F2 untuk fokus."
                             AutomationProperties.Name="Cari produk berdasarkan nama SKU atau barcode"/>
                    <DataGrid Grid.Row="4" x:Name="ProductGrid" ItemsSource="{Binding Products}"
                              MouseDoubleClick="ProductGrid_MouseDoubleClick"
                              AutomationProperties.Name="Hasil pencarian produk">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1.35*"/>
                            <DataGridTextColumn Header="Nama" Binding="{Binding DisplayName}" Width="2.4*"/>
                            <DataGridTextColumn Header="Harga" Binding="{Binding PriceLabel}" Width="1.15*"/>
                            <DataGridTextColumn Header="Stok" Binding="{Binding StockLabel}" Width="0.95*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="0.95*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Tambah ke Keranjang" Style="{StaticResource PrimaryButton}"
                                Click="AddButton_Click" AutomationProperties.Name="Tambahkan produk terpilih ke keranjang"/>
                        <Button Grid.Column="1" Content="Muat Ulang" Click="RefreshButton_Click" />
                        <TextBlock Grid.Column="2" Text="Klik dua kali untuk tambah cepat"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#D5DFDC" BorderThickness="1"
                    CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="*"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Keranjang Transaksi" FontSize="19" FontWeight="SemiBold" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="Jumlah item:" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding ItemCount}" Margin="6,0,0,0" FontWeight="SemiBold"/>
                        <TextBlock Text="   ·  Qty dalam PCS / meter sesuai SKU" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="4" x:Name="CartGrid" ItemsSource="{Binding Cart}"
                              AutomationProperties.Name="Daftar belanja dalam keranjang">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1.3*"/>
                            <DataGridTextColumn Header="Jumlah" Binding="{Binding QuantityLabel}" Width="1*"/>
                            <DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalLabel}" Width="1.25*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="6" Orientation="Horizontal">
                        <TextBlock Text="Jumlah" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBox x:Name="QuantityBox" Width="100" Text="1"
                                 ToolTip="Gunakan titik untuk desimal, misalnya 2.50 meter."
                                 AutomationProperties.Name="Jumlah produk dalam pcs atau meter"/>
                        <Button Content="Hapus Item" Click="RemoveButton_Click" Margin="12,0,0,0"/>
                        <Button Content="Kosongkan" Click="ClearButton_Click"/>
                    </StackPanel>
                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="TOTAL" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TotalText" Text="Rp0" FontSize="28"
                                   FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    </Grid>
                    <Grid Grid.Row="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Uang diterima (IDR)" Margin="0,0,0,5"/>
                            <TextBox x:Name="PaidBox" Text="0" MinWidth="190"
                                     TextChanged="PaidBox_TextChanged"
                                     AutomationProperties.Name="Jumlah uang tunai diterima dalam rupiah"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="Kembalian" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="ChangeText" Text="Rp0" FontSize="21" FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="CheckoutButton" Content="Selesaikan Pembayaran (F4)" Style="{StaticResource PrimaryButton}"
                                Click="CheckoutButton_Click" Margin="0,0,0,0"
                                AutomationProperties.Name="Selesaikan pembayaran tunai"/>
                        <TextBlock Grid.Column="1" Text="Offline · tunai" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="#E7ECEA" CornerRadius="5" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Siap. Cari produk untuk memulai transaksi."
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Column="1" Text="SOFTWARE ONLY · perangkat fisik belum terhubung"
                           FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
